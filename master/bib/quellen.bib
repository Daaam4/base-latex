  doi       = {10.1109/SoSE66311.2025.11083847},
  note      = {Compiles KerML/SysML v2 range-based constraints (\texttt{oneOf}/\texttt{anyOf}/\texttt{allOf}) into a Constraint Satisfaction Problem and solves it via constraint propagation -- explicitly static, explicitly excludes dynamic/behavioral analysis ("restrict constraint propagation to... the static structure... excluding dynamic behaviors"). Uses "valid/validation" only informally for constraint satisfaction. Audited 19.09.2026, verdict: Verification. PDF at \texttt{bib/papers/ratzke2025constraints.pdf}.}
}

% ---------- Subject 5: Agent evaluation & tooling benchmarks (adjacent domains) ----------

@misc{liparulo2026hwmcp,
  author       = {Liparulo, Leonardo and Pierri, Francesco},
  title        = {Benchmarking {AI} Agents for Hardware Design Automation via {MCP} Tool Calling},
  year         = {2026},
  month        = aug,
  howpublished = {arXiv:2608.26199 [cs.AI]},
  doi          = {10.48550/arXiv.2608.26199},
  note         = {Methodological sibling in an adjacent domain: an MCP server that reproduces the state and dependency logic of a proprietary hardware-design tool, plus a benchmark of single-operation edits, multi-step dependency chains, invalid requests and misspelled prompts, evaluated on seven open-source models under ablations of system prompt, tool-description detail, context scope and single- vs.\ multi-agent architecture (metric: expected-call coverage). Findings directly informing the bridge/benchmark design: comprehensive tool descriptions consistently reduce failures; few-shot prompting can cause severe inaction in some models; cumulative context harms constrained models; multi-agent decomposition helps weak workers/long sessions at extra call cost. Its task taxonomy (single-op/chain/invalid/misspelled) maps onto the SysML v2 benchmark's difficulty tiers. PDF at \texttt{bib/papers/liparulo2026hwmcp.pdf}.}
}

@misc{hasan2026mcpsmells,
  author       = {Hasan, Mohammed Mehedi and Li, Hao and Rajbahadur, Gopi Krishnan and Adams, Bram and Hassan, Ahmed E.},
  title        = {Model Context Protocol ({MCP}) Tool Descriptions Are Smelly! Towards Improving {AI} Agent Efficiency with Augmented {MCP} Tool Descriptions},
  year         = {2026},
  month        = feb,
  howpublished = {arXiv:2602.14878},
  doi          = {10.48550/arXiv.2602.14878},
  note         = {Empirical study of 856 tools across 103 MCP servers, using six description components from the literature to build a scoring rubric and formalise "smells" (operationalised by an FM-based scanner): 97.1\,\% of descriptions carry at least one smell, 56\,\% fail to state purpose. Augmenting all components raises task success by a median 5.85 pp and partial completion by 15\,\%, but increases execution steps by 67\,\% and regresses performance in 17\,\% of cases; compact component combinations often preserve reliability at lower token cost. Supplies a rubric for the bridge's tool-description design and identifies a confound to control between the thin and semantic bridge arms: description quality must be held constant so the semantic arm does not win merely on better-written tools. PDF at \texttt{bib/papers/hasan2026mcpsmells.pdf}.}
}
