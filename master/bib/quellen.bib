  author      = {{International Council on Systems Engineering (INCOSE)}},
  title       = {{Systems Engineering Vision 2020}},
  institution = {INCOSE},
  year        = {2007},
  month       = sep,
  type        = {Technical Product},
  number      = {INCOSE-TP-2004-004-02, v2.03},
