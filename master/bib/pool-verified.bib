% ---------- Model under test (types 1 + 3) ----------

@article{helle2026apollo,
  author  = {Helle, Philipp and Schramm, Gerrit},
  title   = {Fly me to the Moon -- Modeling Apollo 11 Using SysML v2},
  journal = {Systems Engineering},
  year    = {2026},
  month   = jun,
  doi     = {10.1002/sys.70074},
  note    = {[TOP 3] Presents the open-source Apollo 11 SysML v2 model (Airbus Central R\&T, MPL-2.0, $\approx$7\,kLOC, five CoSMA layers) explicitly intended as a benchmark for next-generation MBSE tools. Method: modelling case study with documented layering, traceability and deliberate gaps. Chosen as the system under test for all use-case experiments; the documented gaps seed the \emph{Validierung} and \emph{Korrektur} tasks.}
}

@misc{gfse-models,
