% ---------- LLMs / agents for SysML v2 and MBSE (type 1) ----------

@article{dehart2024llm,
  author  = {DeHart, John K.},
  title   = {Leveraging Large Language Models for Direct Interaction with {SysML} v2},
  journal = {INCOSE International Symposium},
  volume  = {34},
  number  = {1},
  pages   = {2168--2185},
  year    = {2024},
  month   = jul,
  doi     = {10.1002/iis2.13262},
  note    = {The founding paper of the topic: argues that SysML v2's English-like textual syntax and the maturation of LLMs make conversational interaction with system models feasible, and that LLMs can replace API expertise as the interface. Method: conceptual analysis with case studies; explicitly warns of automation bias. Provides the vision the thesis puts to an empirical test.}
}

@inproceedings{fresemann2025review,
  author    = {Fresemann, Carina and Ellsel, Claudius and Grunenwald, Carl-Philipp and Stark, Rainer},
  title     = {Using Large Language Models for System Modeling: Current State and Future Implications},
  booktitle = {2025 IEEE International Symposium on Systems Engineering (ISSE)},
  year      = {2025},
  month     = oct,
  pages     = {1--8},
  publisher = {IEEE},
  doi       = {10.1109/ISSE65546.2025.11369978},
  note      = {Structured review of 20 publications on LLMs for MBSE tasks (creation, analysis, modification, reformulation), plus a modular prompting framework for SysML v1$\rightarrow$v2 translation. Points to MCP as the emerging mechanism for supplying engineering context. Provides the task taxonomy on which the use-case catalogue (Abfragen, Validierung, \dots) is mapped.}
}

@inproceedings{dehn2025nl2sysml,
  author    = {Dehn, Simon and Schn{\"u}rer, Simon and Jacobs, Georg and H{\"o}pfner, Gregor},
  title     = {Generating {SysML} v2 Models from Natural Language Requirements Using Large Language Models},
  booktitle = {2025 IEEE International Symposium on Systems Engineering (ISSE)},
  year      = {2025},
  month     = oct,
  pages     = {1--7},
  publisher = {IEEE},
  doi       = {10.1109/ISSE65546.2025.11369988},
  note      = {Four-component prompting (role, ontology, few-shot, requirements) for NL$\rightarrow$SysML v2, evaluated on an automotive electric-window case with precision/recall/F1 and syntax metrics. Reference point for the \emph{Erstellen} use case and its element-level metrics; file-based generation without a modelling tool.}
}

@inproceedings{qualis2025hallucination,
  author    = {Qualis, Richard A.},
  title     = {Mitigating Hallucinations in {SysML} v2 Generation Using {LLMs} and a Tri-Layered Knowledge Graph Reasoning Framework},
  booktitle = {2025 ACM/IEEE 28th International Conference on Model Driven Engineering Languages and Systems Companion (MODELS-C)},
  year      = {2025},
  month     = oct,
  pages     = {357--366},
  publisher = {IEEE},
  doi       = {10.1109/MODELS-C68889.2025.00054},
  note      = {Three-layer knowledge graph (SysML patterns / domain constructs / system-specific) to ground SysML v2 generation and reduce hallucinated constructs; satellite case study measuring structural validity and semantic fidelity. Motivates grounding the agent in the \emph{live} model instead of a hand-built static KG.}
}

@inproceedings{wu2025sysforge,
  author    = {Wu, Rui and Wen, Guangwei and Zhang, XiaoNing and Liang, Xiaojun and Yang, Chunhua and Gui, Weihua},
  title     = {Knowledge-Augmented Conversational Agents for Dependency-Aware {SysML} v2 Model Generation and Refinement},
  booktitle = {2025 IEEE 26th China Conference on System Simulation Technology and its Applications (CCSSTA)},
  year      = {2025},
  month     = jul,
  pages     = {581--586},
  publisher = {IEEE},
  doi       = {10.1109/IEEECONF65522.2025.11137199},
  note      = {SysForge: multi-agent framework (conversational, context-synthesizer, designer and validator agents) with dependency-aware KG retrieval and iterative refinement; beats plain LLM and semantic-RAG baselines on Pass@1 and BLEU. Closest prior work for \emph{Korrektur} through a generate--validate loop; file-based and without an industrial tool.}
}

@article{quast2026graphrag,
  author  = {Quast, Vincent and Jacobs, Georg and Dehn, Simon and H{\"o}pfner, Gregor},
  title   = {Enabling Humans and {AI} Systems to Retrieve Information from System Architectures in Model-Based Systems Engineering},
  journal = {Systems},
  volume  = {14},
  number  = {1},
  pages   = {83},
  year    = {2026},
  month   = jan,
  publisher = {MDPI},
  doi     = {10.3390/systems14010083},
  note    = {GraphRAG multi-agent system (supervisor + graph-query agent) over a Neo4j graph parsed from SysML v2 text and schema'd by RFLP; 93\,\% retrieval accuracy on a battery-EV model. Reference for the \emph{Abfragen} use case and its accuracy metric; the thesis queries the live tool instead of a derived graph.}
}

@misc{bouamra2025systemp,
  author       = {Bouamra, Yasmine and Yun, Bruno and Poisson, Alexandre and Armetta, Fr{\'e}d{\'e}ric},
  title        = {{SysTemp}: A Multi-Agent System for Template-Based Generation of {SysML} v2},
  year         = {2025},
  month        = jun,
  howpublished = {arXiv:2506.21608 [cs.AI]},
  doi          = {10.48550/arXiv.2506.21608},
  note         = {Multi-agent, template-driven generation of SysML v2 from natural-language specifications, motivated by the scarcity of training corpora and the complex syntax. Its evaluation section states openly that no semantic evaluation method and no benchmark exist for SysML v2 generation -- the gap citation for the thesis's benchmark contribution.}
}

@article{alshami2026faultloc,
  author  = {Al-Shami, Haitham and Malik, Rohail and Ala-Laurinaho, Riku and Veps{\"a}l{\"a}inen, Jari and Viitala, Raine},
  title   = {Automated Semantic Fault Localization in {SysML} v2: A Human-in-the-Loop Framework Using Knowledge-Graph Augmented {LLMs}},
  journal = {INCOSE International Symposium},
  volume  = {36},
  number  = {1},
  pages   = {1274--1286},
  year    = {2026},
  month   = jul,
  doi     = {10.1002/iis2.70189},
  note    = {Fine-tuned small language model plus a domain KG of physical compatibility rules that localises and repairs \emph{semantic} faults which pass SysML v2 syntax validation; synthetic faults injected via the KG, output as unified-diff patches, 1\,184 test samples, repair rate $<$3\,\% $\rightarrow$ $>$91\,\%. Direct methodological precedent for the fault-injection design of the \emph{Korrektur} use case and for the syntactic/semantic fault distinction.}
}

@article{bazzal2026mcpmbse,
  author  = {Bazzal, Mahmoud and Schleifer, Simon and Lungu, Adriana and Kruse, Benjamin and Goetz, Stefan and Koldewey, Christian and Tissen, Denis and Wartzack, Sandro J. and Dumitrescu, Roman},
  title   = {Model Context Protocol for {MBSE}: A Unified Interoperable Agentic Framework for Systems Modelling},
  journal = {Proceedings of the Design Society},
  volume  = {6},
  pages   = {2721--2730},
  year    = {2026},
  month   = jul,
  publisher = {Cambridge University Press},
  doi     = {10.1017/pds.2026.10630},
  note    = {[TOP 3] Fraunhofer IEM / FAU framework for implementing MCP servers on top of the standard SysML v2 API, so that LLMs can operate on system models interoperably across tools. Closest scientific competing work: it delivers the \emph{artifact} class the thesis builds, but (per abstract) without a capability evaluation and via the standard REST API rather than a tool-internal interface. The thesis is positioned as the missing empirical evaluation. Full text to be checked (open access, CC BY-NC-ND).}
}

@inproceedings{ahlbrecht2025mbsqle,
  author    = {Ahlbrecht, Alexander and Zaeske, Wanja Marlo Moritz and Durak, Umut},
  title     = {{MBSqlE}: Enabling {SQL} as Powerful Query Language for {SysML} v2 in Aviation},
  booktitle = {44th AIAA DATC/IEEE Digital Avionics Systems Conference (DASC 2025)},
  year      = {2025},
  month     = sep,
  address   = {Montreal, Canada},
  publisher = {IEEE},
  url       = {https://elib.dlr.de/214792/},
  note      = {DLR Institute of Flight Systems: shows that the standard SysML v2 API query model offers no direct graph traversal and hence hits performance bottlenecks on large models, and proposes SQLite as an intermediate, traversable representation (open-source \texttt{DLR-FT/sysml-v2-sql}). Technical motivation for the semantic/cache layer of the bridge and for querying inside the tool rather than through the REST API; PDF at \texttt{bib/papers/ahlbrecht2025mbsqle.pdf}.}
}

% ---------- Agent evaluation & tooling benchmarks in engineering (type 1) ----------

@misc{liparulo2026hwmcp,
  author       = {Liparulo, Leonardo and Pierri, Francesco},
  title        = {Benchmarking {AI} Agents for Hardware Design Automation via {MCP} Tool Calling},
  year         = {2026},
  month        = aug,
  howpublished = {arXiv:2608.26199 [cs.AI]},
  doi          = {10.48550/arXiv.2608.26199},
  note         = {Methodological sibling in an adjacent domain: an MCP server that reproduces the state and dependency logic of a proprietary hardware-design tool, a benchmark of single-operation edits, dependency chains, invalid and misspelled requests, and seven models under pipeline ablations. Findings -- comprehensive tool descriptions reduce failures, few-shot can cause inaction, cumulative context hurts constrained models -- directly inform the bridge and benchmark design.}
}

@misc{shi2026cae,
  author       = {Shi, Jiasheng and Zhang, Tianhan},
  title        = {What Do {CAE} Simulation Agents Really Need Beyond a Generic Harness?},
  year         = {2026},
  month        = sep,
  howpublished = {arXiv:2609.03718 [cs.CE]},
  doi          = {10.48550/arXiv.2609.03718},
  note         = {With information access and repair budget held fixed, a single-agent generic harness matches or beats specialised multi-agent CAE systems (FoamBench 96.4\,\% vs.\ 88.2\,\%); execution-feedback repair and domain tutorials explain the gains, scripted reflection adds nothing. Counter-evidence to H2 (semantic bridge $>$ thin bridge) that the ablation must engage.}
}

@misc{wang2026pufibara,
  author       = {Wang, Zizhe},
  title        = {Beyond Executable Models: The {Pufibara} Agent Harness and the {Modelica} Agent Workflow Benchmark for Physical System Modeling},
  year         = {2026},
  month        = aug,
  howpublished = {arXiv:2608.23653 [cs.SE]},
  doi          = {10.48550/arXiv.2608.23653},
  note         = {232-task benchmark (repair, generation, tuning) for Modelica agents, with a source-grounded task-construction method and a benchmark-owned evaluator outside the agent loop; compares two complete harnesses under matched LLM backends. The external-evaluator principle and the repair/generation/tuning split are adopted for the SysML v2 benchmark.}
}

@misc{shefa2026reqquality,
  author       = {Shefa, Jannatul and Salado, Alejandro and Wach, Paul and Topcu, Taylan G.},
  title        = {Two Truths and A Lie? Benchmarking Off-the-Shelf {LLMs} for Requirements Quality Assessment: Performance, False Alarms, and Misses},
  year         = {2026},
  month        = sep,
  howpublished = {arXiv:2609.03230 [cs.SE]},
  doi          = {10.48550/arXiv.2609.03230},
  note         = {Ten OpenAI/Anthropic models, 100 runs, expert ground truth on INCOSE quality criteria: the best model finds a median of only 47\,\% of expert-identified issues, judgement-heavy criteria are almost always missed, generational progress is non-monotonic. Justifies expert-defined acceptance criteria and a second human rater instead of LLM-as-judge in the evaluation design.}
}

@misc{pradasgomez2026ductile,
  author       = {Pradas-Gomez, Alejandro and Brahma, Arindam and Isaksson, Ola},
  title        = {{DUCTILE}: Agentic {LLM} Orchestration of Engineering Analysis in Product Development Practice},
  year         = {2026},
  month        = mar,
  howpublished = {arXiv:2603.10249},
  doi          = {10.48550/arXiv.2603.10249},
  note         = {Separates adaptive orchestration by the LLM agent from deterministic execution by verified engineering tools, demonstrated on an industrial aerospace structural-analysis task; evaluated against expert-defined acceptance criteria over 10 repeated independent runs and in deployment with engineers. Template for the agent--tool division of labour and for repeated-run reliability reporting.}
}

@misc{molinari2026engiai,
  author       = {Molinari, Gioele and Felten, Florian and Massoudi, Soheyl and Fuge, Mark},
  title        = {{EngiAI}: Capability-Based Evaluation of Tool-Connected {LLM} Agents for Engineering Design},
  year         = {2026},
  month        = may,
  howpublished = {arXiv:2605.19743 (extended version of an ASME IDETC-CIE 2026 paper)},
  doi          = {10.48550/arXiv.2605.19743},
  note         = {Capability-based evaluation framework for tool-connected engineering agents that scores workflow execution, retrieval-assisted parameter selection, HPC orchestration and code authoring separately from execution traces and artifacts; four LLM backends on EngiBench problems. Argues for capability-specific scores over end-to-end demos -- the rationale for evaluating per use case rather than per end-to-end task.}
}

@misc{hasan2026mcpsmells,
  author       = {Hasan, Mohammed Mehedi and Li, Hao and Rajbahadur, Gopi Krishnan and Adams, Bram and Hassan, Ahmed E.},
  title        = {Model Context Protocol ({MCP}) Tool Descriptions Are Smelly! Towards Improving {AI} Agent Efficiency with Augmented {MCP} Tool Descriptions},
  year         = {2026},
  month        = feb,
  howpublished = {arXiv:2602.14878},
  doi          = {10.48550/arXiv.2602.14878},
  note         = {Empirical study of 856 tools across 103 MCP servers: 97\,\% of tool descriptions contain at least one smell; augmenting descriptions raises task success by a median 5.85 pp but increases execution steps by 67\,\%. Supplies the description rubric for the bridge's tool surface and a confound to control between the thin and semantic arms.}
}

% ---------- Grey literature (type 2) ----------

@misc{sei-native-ai,
  author       = {{Software Engineering Institute, Carnegie Mellon University}},
  title        = {Native {AI} Integration for Model-Based Systems Engineering: Three Layers that Make It Work},
  year         = {2026},
  howpublished = {SEI Blog, \url{https://www.sei.cmu.edu/blog/native-ai-integration-for-model-based-systems-engineering-three-layers-that-make-it-work/}, accessed 12.09.2026},
  note         = {[TOP 3] Controlled three-arm SysML v2 experiment (no tools / validation loop / MCP knowledge server + skills; 8 tasks, Claude Opus 4.6): iterative validation eliminates syntax errors, curated knowledge raises pattern conformance from 71.7 to 94.1. Grey literature, but the only controlled tooling ablation on SysML v2 to date; file-based, so the thesis differentiates on the live-model / industrial-tool axis and adopts its ablation template.}
}
