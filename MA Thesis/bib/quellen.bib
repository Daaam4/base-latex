% ---------- Model under test ----------

@article{helle2026apollo,
  author  = {Helle, Philipp and Schramm, Gerrit},
  title   = {Fly me to the Moon -- Modeling Apollo 11 Using SysML v2},
  journal = {Systems Engineering},
  year    = {2026},
  doi     = {10.1002/sys.70074},
  note    = {[TOP 3] Presents the open-source Apollo 11 SysML v2 model (Airbus Central R\&T, MPL-2.0, $\approx$7\,kLOC, five CoSMA layers) explicitly intended as a benchmark for next-generation MBSE tools. Chosen as the system under test for all use-case experiments.}
}

@misc{gfse-models,
  author       = {{GfSE -- Gesellschaft f{\"u}r Systems Engineering}},
  title        = {{SysML-v2-Models: A curated collection of high-quality SysML v2 models}},
  year         = {2025},
  howpublished = {\url{https://github.com/GfSE/SysML-v2-Models}},
  note         = {Curated BSD-licensed collection of small SysML v2 models, explicitly meant to help train and test LLM-based tooling. Used as secondary/generalisation test set and as source of good/bad examples.}
}

% ---------- Tool / bridge ----------

@misc{nomagic-sysml2,
  author       = {{Dassault Syst{\`e}mes}},
  title        = {{CATIA Magic/Cameo SysML v2 Solution}},
  year         = {2026},
  howpublished = {\url{https://docs.nomagic.com/SYSML2P/latest/}},
